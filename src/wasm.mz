# WebAssembly host-language access (GraalWasm).
#
# WebAssembly's interop model is deliberately narrow: a wasm module is a compiled
# binary blob with named function/memory/global/table exports, and every value
# crossing the boundary is a numeric primitive (i32, i64, f32, f64). There is no
# source-level `eval`, no OOP, no per-object methods — everything is a top-level
# export.
#
# THIS PACKAGE WRITES NO NATIVES. Like the Python and JS providers, every op
# delegates to the first-party `Polyglot` effect in `std::polyglot::core` (handled
# by `Runtime`, the sole native caller). Wasm needs three ops beyond the shared
# value verbs — all generic, all in core: `eval_bytes` (binary module compile),
# `read_bytes`/`write_bytes` (bulk linear-memory copy), and `box_i32` (the i32
# ABI). Each verb buries its own `perform Runtime`, so a user calls
# `mod.call_export{}` with no enclosing perform and never sees a `Polyglot.*` op
# or the "wasm" guest id (baked in once, at the entry points).
#
# `load_module` composes in pure Mezze what the old native did in one step:
# `eval_bytes` (compile) then `instantiate` then read the `exports` member.
#
# Loading a module FROM A FILE is intentionally not a Wasm op: reading a file is a
# FileSystem capability, orthogonal to wasm. A caller reads bytes with
# `std::effects::filesystem` (which they already hold) and passes them to
# `load_module` — keeping the Wasm effect row clean.
#
# Because wasm cannot represent strings/records/lists/variants natively, the codec
# surface (`mezze_wasm::codec`) is limited to scalar numeric encode/decode.
use std::polyglot::core::{ InteropError, Polyglot, Runtime, Foreign }

## Opaque handle to a wasm module instance or exported value (function, memory,
## global). Wraps the public `Foreign` handle (never the internal native
## primitive); the newtype gives Mezze-level type safety against mixing wasm and
## non-wasm Foreigns.
pub newtype WasmForeign = Foreign

## WebAssembly host effect. `load_module` accepts a raw wasm binary and returns the
## instantiated module's `exports` namespace — every export is reachable via
## `get_export` / `call_export`.
effect Wasm where {
  load_module: { bytes: Bytes, name: Str } -> Result WasmForeign InteropError <Wasm>,
}

## Default WebAssembly host — routes through the ambient Truffle Env's GraalWasm
## interpreter. Zero-field: the polyglot Context is managed by the runtime from
## `Mezze.toml [polyglot.wasm]`; the handler carries no user-visible configuration.
## The handler type is introduced by the impl itself — no separate `type` needed.
impl Wasm for GraalWasm where {
  ## Compile → instantiate → read `exports`, all via the shared Polyglot effect.
  ## "wasm" is baked here (the one entry point).
  load_module = { bytes, name } -> perform Runtime in do
    match Polyglot.eval_bytes { lang = "wasm", bytes = bytes, name = name } is
      Ok  { val = module } -> match Polyglot.instantiate { on = module, args = [] } is
        Ok  { val = instance } -> Polyglot.read_member { on = instance, name = "exports" }
        Err { error } -> Err { error = error }
      Err { error } -> Err { error = error },
}

## Inherent methods on WasmForeign — the wasm-idiomatic vocabulary plus the small
## universal surface that makes sense for wasm. Every verb buries its own
## `perform Runtime`, so chains run with no enclosing perform.
impl WasmForeign where {
  ## ---- Exports ----

  ## Look up an exported function / memory / global by name.
  get_export = { it, name } ->
    perform Runtime in Polyglot.read_member { on = it, name = name },

  ## Invoke a callable Foreign (typically an exported function) with a list of
  ## numeric-primitive arguments (lift Mezze scalars via `from_int` / `from_float`).
  call = { it, args } ->
    perform Runtime in Polyglot.execute { on = it, args = args },

  ## Convenience: look up an export by name AND invoke it in one call.
  call_export = { it, name, args } -> perform Runtime in do
    match Polyglot.read_member { on = it, name = name } is
      Ok  { val = f } -> Polyglot.execute { on = f, args = args }
      Err { error } -> Err { error = error },

  ## ---- Linear memory ----

  ## Read `length` bytes from linear memory starting at `offset`. The receiver must
  ## be the module's memory export (typically `module.get_export { name = "memory" }`).
  memory_read = { it, offset, length } ->
    perform Runtime in Polyglot.read_bytes { on = it, offset = offset, length = length },

  ## Write a byte buffer into linear memory at `offset`. The receiver must be a
  ## writable memory export. Errors on out-of-range.
  memory_write = { it, offset, bytes } ->
    perform Runtime in Polyglot.write_bytes { on = it, offset = offset, bytes = bytes },

  ## Total size (in bytes) of a memory export.
  memory_size = { it } ->
    perform Runtime in Polyglot.size { on = it },

  ## ---- Universal vocabulary (numeric + null + meta) ----

  ## Coerce a numeric Foreign to Int.
  as_int    = { it } -> perform Runtime in Polyglot.as_int    { on = it },
  ## Coerce a numeric Foreign to Float.
  as_float  = { it } -> perform Runtime in Polyglot.as_float  { on = it },
  ## True iff this Foreign is the guest-language null.
  is_null   = { it } -> perform Runtime in Polyglot.is_null   { on = it },
  ## Debug name of the underlying wasm type (function, memory, global, i32, f64, …).
  type_name = { it } -> perform Runtime in Polyglot.type_name { on = it },
}

## Chainable inherent methods on `Result WasmForeign InteropError` — the return
## type of every fallible operation above — so a pipeline reads as a flat chain
##
##     Wasm.load_module { bytes = wasm, name = "add" }
##       .get_export { name = "add" }
##       .call { args = [from_int { val = 2 }, from_int { val = 3 }] }
##       .as_int {}
##
## with no `match` between steps. On `Ok` it delegates to the underlying
## `WasmForeign`; on `Err` it propagates unchanged. The generic `impl Result 'a 'e`
## (map / get_or / flat_map / …) still applies on top.
impl Result WasmForeign InteropError where {
  get_export = { it, name } -> match it is
    Ok  { val = f } -> f.get_export { name = name }
    Err { error }   -> Err { error = error },
  call = { it, args } -> match it is
    Ok  { val = f } -> f.call { args = args }
    Err { error }   -> Err { error = error },
  call_export = { it, name, args } -> match it is
    Ok  { val = f } -> f.call_export { name = name, args = args }
    Err { error }   -> Err { error = error },
  memory_read = { it, offset, length } -> match it is
    Ok  { val = f } -> f.memory_read { offset = offset, length = length }
    Err { error }   -> Err { error = error },
  memory_write = { it, offset, bytes } -> match it is
    Ok  { val = f } -> f.memory_write { offset = offset, bytes = bytes }
    Err { error }   -> Err { error = error },
  memory_size = { it } -> match it is
    Ok  { val = f } -> f.memory_size {}
    Err { error }  -> Err { error = error },
  as_int = { it } -> match it is
    Ok  { val = f } -> f.as_int {}
    Err { error }  -> Err { error = error },
  as_float = { it } -> match it is
    Ok  { val = f } -> f.as_float {}
    Err { error }  -> Err { error = error },
  is_null = { it } -> match it is
    Ok  { val = f } -> Ok { val = f.is_null {} }
    Err { error }  -> Err { error = error },
  type_name = { it } -> match it is
    Ok  { val = f } -> Ok { val = f.type_name {} }
    Err { error }  -> Err { error = error },
}

## Constructors — lift a Mezze numeric primitive into a WasmForeign so it can be
## passed to `.call{}` / `.call_export{}`. `from_int` mints a 32-bit i32 (wasm's
## function ABI rejects a 64-bit Long for an i32 parameter); `from_float` mints an
## f64 that GraalWasm narrows to f32 where a signature calls for it. Both go through
## the `Polyglot` effect with the guest id "wasm" baked in here. Wasm has no native
## string / bool boundary type, so those constructors are deliberately absent.
## `<*>`: these bury `perform Runtime` (a provider can't call natives), so their
## bodies handle an effect and the annotation must say so — a caller can't tell a
## fully-discharged body from a pure one otherwise. Use them inside a function
## (module-top-level effectful bindings are rejected).
pub let from_int:   { val: Int   } -> WasmForeign <*> = { val } ->
  perform Runtime in Polyglot.box_i32   { val = val, lang = "wasm" }
pub let from_float: { val: Float } -> WasmForeign <*> = { val } ->
  perform Runtime in Polyglot.box_float { val = val, lang = "wasm" }
